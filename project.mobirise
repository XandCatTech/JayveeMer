    "google-analytics": "    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"description\" content=\"XandCat: Elevating Your Digital Presence. Discover our comprehensive services, including website development, software engineering, graphic design, video editing, and technical solutions. Our unique approach blends expertise, passion, and client-centricity to deliver outstanding results that surpass expectations.\">\n    <meta name=\"keywords\" content=\"XandCat, website development, software engineering, graphic design, video editing, computer repairs, laptop repairs, technical solutions, client-centric, exceptional results, digital presence\">\n    <meta name=\"author\" content=\"Jayvee Mer Dela Cruz\">",
